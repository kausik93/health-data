# Copy to .env and adjust paths for your environment.

# Diet: directory containing mynetdiary_{year}_food.csv exports
MYNETDIARY_RAW_DIR=data/raw/diet

# Exercise: Hevy export JSON files
HEVY_WORKOUTS_PATH=data/raw/exercise/workouts_master.json
HEVY_ROUTINES_PATH=data/raw/exercise/routines_master.json

# Backups
HEALTH_DB_BACKUP_DIR=backups
HEALTH_DB_BACKUP_RETENTION=12
